# Copy this file to .env.local for local development.
# On Vercel, add the same variables under Project Settings -> Environment Variables.

# Your deployed site URL (used for SEO metadata, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# WhatsApp number with country code, digits only (e.g. 919876543210). Leave empty until you add it.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Your LinkedIn profile URL (e.g. https://www.linkedin.com/in/your-handle). Leave empty until you add it.
NEXT_PUBLIC_LINKEDIN_URL=
